# Copy this file to .env for local development. Never commit .env.
# All entries are optional; the app runs with local SQLite if no database is set.

# AI results assistant (optional)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Shared persistence (optional). Without this, runs are stored in recomb_app.db.
# SUPABASE_DB_DSN=postgresql://USER:PASSWORD@HOST:6543/postgres

# Admin account on the live workbench (optional)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Google sign-in (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8050/api/auth/google/callback
